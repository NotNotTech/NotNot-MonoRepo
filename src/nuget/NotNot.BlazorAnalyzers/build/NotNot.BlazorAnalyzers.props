<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!--
    XRay Source Line Metadata Generator
    Register .razor files as AdditionalTexts for the source generator.
    Exclude build output directories to avoid processing generated files.
    -->
    <ItemGroup>
        <AdditionalFiles Include="**/*.razor" Exclude="bin/**;obj/**;.vs/**" />
    </ItemGroup>

    <!--
    Localization Analyzer — Code-behind files
    Register .razor.cs files as AdditionalTexts for C# string analysis.
    -->
    <ItemGroup>
        <AdditionalFiles Include="**/*.razor.cs" Exclude="bin/**;obj/**;.vs/**" />
    </ItemGroup>

    <!--
    CSS Modernization Analyzer
    Register .css files as AdditionalTexts for CSS rule analysis.
    Excludes vendor libraries typically found in wwwroot/lib/.
    -->
    <ItemGroup>
        <AdditionalFiles Include="**/*.css" Exclude="bin/**;obj/**;.vs/**;**/wwwroot/lib/**" />
    </ItemGroup>

    <!-- Expose build properties to analyzers/generators via CompilerVisibleProperty -->
    <ItemGroup>
        <CompilerVisibleProperty Include="XRayGeneratorEnabled" />
        <CompilerVisibleProperty Include="CssAnalyzerEnabled" />
        <CompilerVisibleProperty Include="LocalizationAnalyzerEnabled" />
        <CompilerVisibleProperty Include="NnDesignPolicyAnalyzerEnabled" />
    </ItemGroup>
</Project>
