<Project Sdk="Microsoft.NET.Sdk">

	<!--shared common .csproj settings-->
	<Import Project="..\..\CommonSettings.targets" />
	
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<Configurations>Debug;Release;DebugNuget</Configurations>
		
		<!-- Analyzer-specific settings -->
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Deterministic>true</Deterministic>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- Ensure analyzer deps are copied to bin for VS MEF resolution when referenced as ProjectReference -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="bin\**" />
		<Compile Remove="Documentation\**" />
		<EmbeddedResource Remove="bin\**" />
		<EmbeddedResource Remove="Documentation\**" />
		<None Remove="bin\**" />
		<None Remove="Documentation\**" />
	</ItemGroup>

	<!-- Core analyzer dependencies (aligned with VS 17.11.x). NO Workspaces reference — that (and its RS1038 trigger)
	     lives in NotNot.Analyzers.CodeFixes, which owns the Workspaces-dependent CodeFixProviders. -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.0.0-1.25277.114" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="4.14.0" />
	</ItemGroup>
	
	<!-- Development-time analyzers (for this project only) -->
	<ItemGroup>
		<PackageReference Include="Roslynator.Analyzers" Version="4.14.1" PrivateAssets="all">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.0.0-1.25277.114" PrivateAssets="all">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.8.2-beta.1" PrivateAssets="all">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	
	<!-- Build tools -->
	<ItemGroup>
		<PackageReference Include="editorconfig" Version="0.15.0" PrivateAssets="all" />
		<PackageReference Include="MinVer" Version="6.1.0-beta.1" PrivateAssets="all">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- Packing lives in NotNot.Analyzers.Package (the pack-only aggregator). This project ships NO nupkg;
	     it is consumed as an analyzer ProjectReference and its dll is packed by the aggregator.
	     MinVer (assembly versioning) is retained in the Build-tools ItemGroup above. -->

	<!-- Debug configuration -->
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

</Project>
